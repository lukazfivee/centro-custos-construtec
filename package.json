{
  "name": "centro-de-custos",
  "version": "2.1.7",
  "private": true,
  "description": "Gestão offline de receitas, despesas e centros de custo com sincronização por planilha",
  "main": "desktop/main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "check": "node scripts/check-syntax.js",
    "test": "node --test",
    "electron": "electron desktop/main.js",
    "build": "electron-builder --win && node scripts/fix-latest-yml.js",
    "build:portable": "electron-builder --win portable",
    "build:dir": "electron-builder --win --dir",
    "fix-yml": "node scripts/fix-latest-yml.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.2",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "electron-updater": "^6.8.9",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.construtec.centro-custos",
    "productName": "Centro de Custos Construtec",
    "directories": {
      "output": "dist"
    },
    "files": [
      ".env",
      "server.js",
      "db.js",
      "routes/**/*",
      "services/**/*",
      "lib/**/*",
      "middleware/**/*",
      "migrations/**/*",
      "public/**/*",
      "desktop/main.js",
      "desktop/preload.js",
      "desktop/icon.png"
    ],
    "asarUnpack": [
      "node_modules/@electric-sql/**/*",
      "node_modules/bcryptjs/**/*"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "desktop/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Centro de Custos Construtec"
    },
    "publish": {
      "provider": "github",
      "owner": "lukazfivee",
      "repo": "lukazfivee/centro-custos-construtec"
    }
  }
}
